#!/bin/bash
set -uo pipefail

if [[ $# -gt 1 ]]; then
  echo "Usage: $0 [test-file]" >&2
  exit 2
fi

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." || exit 1
if [[ -n ${1:-} && ! -f $1 ]]; then
  echo "Test file not found: $1" >&2
  exit 2
fi

test_output=$(mktemp) || exit 1
trap 'rm -f -- "$test_output"' EXIT
status=0
DAPUI_TEST_FILE="${1:-}" "${NVIM:-nvim}" --headless --noplugin -i NONE -u tests/init.vim \
  -c 'lua dofile("tests/run.lua")' 2>&1 | tee "$test_output" || status=$?

# Some Plenary versions report setup errors without a failing process status.
awk '
  { gsub(/\033\[[0-9;]*m/, "") }
  /(Errors|Failed) :/ && $3 > 0 { failed = 1 }
  END { exit failed }
' "$test_output" || status=1

exit "$status"
